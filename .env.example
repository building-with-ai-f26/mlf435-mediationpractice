# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# On a host, set OPENROUTER_API_KEY as a real environment variable; it is read before .env.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional server settings (defaults shown). The server reads these from real environment variables only,
# not from this file. Set them in your host's settings or in the shell, e.g. LIVE_AI_ENABLED=true node server.mjs
# PORT=3000
# NODE_ENV=production                 # binds 0.0.0.0 and trusts the first x-forwarded-for entry. Otherwise 127.0.0.1.
# PUBLIC_ORIGIN=https://ra.example.edu  # comma separated extra origins (and Hosts) to accept
# LIVE_AI_ENABLED=false               # true turns on /api/chat. When false it returns 503.
# RATE_LIMIT_MAX=60                   # requests per client IP per window on /api/chat and /api/transcript
# RATE_LIMIT_WINDOW_MINUTES=10
# DAILY_CALL_CAP=500                  # global /api/chat calls per UTC day, then 503

# Only for tools/pull-posthog.mjs (never used by the app). A PostHog personal API key with the
# "query:read" scope, and the numeric project id. Leave empty if you do not run that tool.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
